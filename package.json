{
  "name": "bitnari-electron",
  "version": "0.1.0",
  "description": "Ambilight Desktop Control Application built with Electron, SvelteKit, and bits-ui",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev:svelte": "vite dev",
    "dev:electron": "wait-on http-get://localhost:5173 && cross-env NODE_ENV=development electron .",
    "dev": "concurrently -k \"npm run dev:svelte\" \"npm run dev:electron\"",
    "build:svelte": "vite build",
    "build": "npm run build:svelte",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "bits-ui": "^1.3.11",
    "clsx": "^2.1.1",
    "lucide-svelte": "^0.479.0",
    "protobufjs": "^7.4.0",
    "serialport": "^13.0.0",
    "tailwind-merge": "^3.0.2",
    "tailwind-variants": "^0.3.1"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.16.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tailwindcss/vite": "^4.0.9",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^35.0.0",
    "svelte": "^5.20.0",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^4.1.10",
    "wait-on": "^8.0.2"
  }
}
